{
  "branches": [
    "master",
    { "name": "v2", "prerelease": "beta", "channel": "beta" }
  ],
  "tagFormat": "v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "bash .github/scripts/build.sh ${nextRelease.version} && echo ${nextRelease.version} > .release-version"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          { "path": "build/libs/Quests-*.jar" }
        ],
        "successComment": false,
        "failComment": false,
        "failTitle": false,
        "releasedLabels": false
      }
    ]
  ]
}
